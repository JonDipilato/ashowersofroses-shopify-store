{% if section.settings.show_band and section.settings.message != blank %}
  <aside class="announcement-band" role="status">
    <div class="page-width announcement-band__inner">
      {% if section.settings.season != blank %}
        <span>{{ section.settings.season }}</span>
      {% endif %}
      <span>{{ section.settings.message }}</span>
      {% if section.settings.link_label != blank and section.settings.link_url != blank %}
        <a
          class="announcement-band__link"
          href="{{ section.settings.link_url }}"
          {% if section.settings.link_new_tab %}target="_blank" rel="noopener"{% endif %}
        >{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
  </aside>
{% endif %}

{% schema %}
{
  "name": "Seasonal band",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_band",
      "label": "Show band",
      "default": true
    },
    {
      "type": "text",
      "id": "season",
      "label": "Liturgical season",
      "default": "Now on Etsy"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Shop the full collection of sacred art canvases, prayer candles, and Catholic gifts."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Visit our Etsy shop"
    },
    {
      "type": "text",
      "id": "link_url",
      "label": "Link (full URL)",
      "default": "https://www.etsy.com/shop/AShowersOfRoses"
    },
    {
      "type": "checkbox",
      "id": "link_new_tab",
      "label": "Open link in a new tab",
      "default": true
    }
  ]
}
{% endschema %}
